{
  "buildCommand": "if command -v flutter &> /dev/null; then flutter build web --release; else echo 'Flutter not installed'; exit 1; fi",
  "outputDirectory": "build/web",
  "framework": null,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|json|ico|png|jpg|jpeg|svg|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
